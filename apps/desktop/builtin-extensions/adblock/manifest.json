{
  "manifest_version": 3,
  "name": "Besplatno AdBlock",
  "version": "1.0.0",
  "description": "Встроенный блокировщик рекламы для Besplatno Browser",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}
